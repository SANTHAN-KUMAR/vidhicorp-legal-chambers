<!-- Newsletter signup — currently captures to Formspree; connect a real ESP (Mailchimp/Brevo) for list management and sends -->
<section class="cta-band grain">
  <div class="container">
    <p class="eyebrow" style="justify-content:center">Subscribe for Legal Updates</p>
    <h2>Get new Legal Updates and Legal Insights in your inbox.</h2>
    <form id="newsletter-form" novalidate action="https://formspree.io/f/xyeypwkd" method="POST" data-ajax data-success-message="Thank you — you're subscribed.">
      <input type="hidden" name="_subject" value="Newsletter signup — VidhiCorp website">
      <div class="btn-row" style="flex-wrap:wrap;justify-content:center;gap:12px">
        <input type="email" name="email" required placeholder="you@company.com" aria-label="Email address" style="max-width:280px;height:54px;padding:0 20px;border-radius:var(--radius-s);border:1px solid var(--border);font-size:15px">
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </div>
      <div class="form-status" role="status" aria-live="polite" style="text-align:center;margin-top:12px"></div>
    </form>
  </div>
</section>
