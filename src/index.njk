---
layout: base.njk
title: "VidhiCorp Legal Chambers | Corporate & Commercial Counsel, Gurugram"
description: "VidhiCorp Legal Chambers advises Indian and international businesses on corporate law, contracts, IP, dispute resolution and compliance, with counsel built around the business — Gurugram, Delhi NCR and across India."
permalink: /
eleventyExcludeFromCollections: true
---
<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <video class="hero-video-el is-active" data-slot="a" data-src="/videos/hero-prevent.mp4" muted loop playsinline preload="none" poster="/images/hero-prevent-poster.jpg"></video>
    <video class="hero-video-el" data-slot="b" muted loop playsinline preload="none"></video>
    <img class="poster-fallback" src="/images/hero-prevent-poster.jpg" alt="VidhiCorp Legal Chambers — corporate and commercial legal counsel in Gurugram" width="1600" height="900" fetchpriority="high" decoding="async">
  </div>
  <div class="hero-mesh" aria-hidden="true"></div>

  <div class="hero-badge" aria-hidden="true">
    <span class="hb-num">20+</span>
    <span class="hb-label">Years advising businesses through growth, risk and dispute: one dedicated partner, start to finish.</span>
  </div>

  <div class="hero-content">
    <p class="eyebrow">VidhiCorp Legal Chambers · Gurugram, India</p>
    <h1 class="hero-title">Legal counsel built around your <em>business</em>.</h1>
    <p class="hero-sub">Mitigate risks before disputes arise, with counsel who understand the commercial decision, not just the legal one.</p>
    <div class="hero-actions">
      <a href="/contact/" class="btn btn-primary">Discuss Your Matter</a>
      <a href="/practice-areas/" class="btn btn-ghost">View Practice Areas
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <nav class="hero-quicklinks" aria-label="Quick links">
      <span class="ql-label">Quick links</span>
      <a class="pill-link" href="/about/">About<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="pill-link" href="/practice-areas/">Practice Areas<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="pill-link" href="/team/">Team<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="pill-link" href="/careers/">Careers<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="pill-link" href="/contact/">Contact<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </nav>
  </div>

  <div class="hero-tabs" role="tablist" aria-label="Firm philosophy">
    <button class="hero-tab is-active" role="tab" aria-selected="true"
      data-video="/videos/hero-prevent.mp4" data-poster="/images/hero-prevent-poster.jpg"
      data-headline="Legal counsel built around your &lt;em&gt;business&lt;/em&gt;."
      data-sub="Mitigate risks before disputes arise, with counsel who understand the commercial decision, not just the legal one.">
      <span class="tab-index">01</span><span class="tab-label">Prevent</span>
    </button>
    <button class="hero-tab" role="tab" aria-selected="false"
      data-video="/videos/hero-protect.mp4" data-poster="/images/hero-protect-poster.jpg"
      data-headline="An extension of your &lt;em&gt;legal team&lt;/em&gt;."
      data-sub="We partner with businesses as an extension of their management and legal functions, to secure interests end to end.">
      <span class="tab-index">02</span><span class="tab-label">Protect</span>
    </button>
    <button class="hero-tab" role="tab" aria-selected="false"
      data-video="/videos/hero-resolve.mp4" data-poster="/images/hero-resolve-poster.jpg"
      data-headline="Practical, business-oriented &lt;em&gt;resolution&lt;/em&gt;."
      data-sub="Litigation, arbitration and negotiation, always weighed against what actually protects the business."
      data-headline-plain="Practical, business-oriented resolution.">
      <span class="tab-index">03</span><span class="tab-label">Resolve</span>
    </button>
  </div>
</section>

<section class="hero-strip bg-ink">
  <div class="container">
    <div class="stat"><b data-count="20" data-suffix="+">0</b><span>Years, multi-jurisdictional experience</span></div>
    <div class="stat"><b>₹1,200+ Cr</b><span>Disputes &amp; arbitration handled</span></div>
    <div class="stat"><b>USD 600M</b><span>Cross-border dispute support</span></div>
    <div class="stat"><b data-count="{{ practiceAreas.length }}">0</b><span>Practice areas</span></div>
  </div>
</section>

<!-- ============ WHO WE ARE ============ -->
<section class="section">
  <div class="container">
    <div class="two-col" style="align-items:stretch">
      <div class="reveal photo-panel" style="aspect-ratio:auto;min-height:520px">
        <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=1000&q=65&auto=format&fit=crop" alt="Corporate legal counsel reviewing a business decision with a client" width="1000" height="1250" loading="lazy" decoding="async">
        <div class="photo-caption">
          <p class="eyebrow" style="color:var(--brass-300)">Who we are</p>
          <p style="font-family:var(--font-display);font-size:22px;line-height:1.5;font-weight:400;color:var(--paper-50);max-width:26ch">Strategic legal solutions across the entire business lifecycle.</p>
          <p class="mt-16" style="color:var(--ink-200);font-size:15px;line-height:1.7;max-width:38ch">Twenty years of multi-jurisdictional experience across Asia-Pacific, Europe and North America, advising business owners and corporate legal counsel across Delhi NCR, Gurugram, Mumbai and India.</p>
          <a href="/about/" class="btn btn-outline mt-24" style="border-color:rgba(247,242,232,.5);color:var(--paper-50)">More About The Firm</a>
        </div>
      </div>
      <div class="reveal-stagger" style="border-top:1px solid var(--border);align-self:center">
        <div class="row-item" style="grid-template-columns:56px 1fr">
          <span class="row-num">01</span>
          <div><h4 style="font-size:17px">Understand Before Advising</h4><p class="mt-8">Understand the business, its objectives and the realities behind every decision.</p></div>
        </div>
        <div class="row-item" style="grid-template-columns:56px 1fr">
          <span class="row-num">02</span>
          <div><h4 style="font-size:17px">Think Beyond the Immediate</h4><p class="mt-8">Anticipate the risks, obligations and consequences that may emerge over time.</p></div>
        </div>
        <div class="row-item" style="grid-template-columns:56px 1fr">
          <span class="row-num">03</span>
          <div><h4 style="font-size:17px">Make the Law Workable</h4><p class="mt-8">Translate legal complexity into clear, practical advice that decision-makers can act on.</p></div>
        </div>
        <div class="row-item" style="grid-template-columns:56px 1fr;border-bottom:1px solid var(--border)">
          <span class="row-num">04</span>
          <div><h4 style="font-size:17px">Stay with the Matter</h4><p class="mt-8">Remain engaged beyond the advice — through implementation, change, renewal and what comes next.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ PRACTICE AREAS ============ -->
<section class="section bg-alt">
  <div class="container">
    <div class="sec-head reveal">
      <div>
        <p class="eyebrow">What we do</p>
        <h2>Practice areas</h2>
        <p>{{ practiceAreas.length }} areas of focused practice in Indian business law, organised the way problems actually arrive at our desk: rarely as a single, isolated question.</p>
      </div>
      <a href="/practice-areas/" class="btn btn-outline sec-link">View All {{ practiceAreas.length }} Practice Areas</a>
    </div>

    <div class="pa-grid reveal">
      {% for pa in practiceAreas %}{% if loop.index <= 6 %}
      <div class="pa-card" id="{{ pa.id }}" data-bg="{{ pa.image }}">
        <span class="pa-card-img" aria-hidden="true"></span><span class="pa-card-scrim" aria-hidden="true"></span>
        <div class="pa-card-body">
          <svg class="pa-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">{{ pa.iconSvg | safe }}</svg>
          <h3>{{ pa.name }}</h3>
          <div class="pa-card-more">
            <p>{{ pa.shortDesc }}</p>
            <a href="/practice-areas/#{{ pa.id }}" class="pa-more">Learn more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
        </div>
      </div>
      {% endif %}{% endfor %}
    </div>

    <div class="pa-rest reveal">
      <p class="pa-rest-label">Also advising on</p>
      <ul class="pa-rest-list">
        {% for pa in practiceAreas %}{% if loop.index > 6 %}
        <li><a href="/practice-areas/#{{ pa.id }}">{{ pa.name }}</a></li>
        {% endif %}{% endfor %}
      </ul>
      <a href="/practice-areas/" class="btn btn-outline pa-rest-cta">View All {{ practiceAreas.length }} Practice Areas
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ============ HOW WE WORK ============ -->
<section class="section">
  <div class="container">
    <div class="sec-head reveal">
      <div>
        <p class="eyebrow">How we work</p>
        <h2>A deliberately small number of steps.</h2>
      </div>
    </div>
    <div class="stack-list">
      <div class="stack-card">
        <span class="stack-img" data-bg="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1000&q=70&auto=format&fit=crop"></span>
        <span class="step-num">01</span>
        <div><h4>Understand the business</h4><p>What it does, how it earns, and what it can realistically absorb.</p></div>
      </div>
      <div class="stack-card">
        <span class="stack-img" data-bg="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1000&q=70&auto=format&fit=crop"></span>
        <span class="step-num">02</span>
        <div><h4>Anticipate the exposure</h4><p>The clause that will matter in year three, not the one in dispute today.</p></div>
      </div>
      <div class="stack-card">
        <span class="stack-img" data-bg="https://images.unsplash.com/photo-1455390582262-044cdead277a?w=1000&q=70&auto=format&fit=crop"></span>
        <span class="step-num">03</span>
        <div><h4>Advise in plain terms</h4><p>Opinions written for the people who act on them, not only for other lawyers.</p></div>
      </div>
      <div class="stack-card">
        <span class="stack-img" data-bg="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=1000&q=70&auto=format&fit=crop"></span>
        <span class="step-num">04</span>
        <div><h4>Stay engaged after signing</h4><p>Available as the matter is implemented, renewed or revisited.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section quote-band grain">
  <div class="container">
    <p class="eyebrow">In their words</p>
    {% for t in testimonials %}{% if loop.index <= 4 %}
    <div class="quote-slide{% if loop.first %} is-active{% endif %}">
      <blockquote class="quote">&ldquo;{{ t.quote }}&rdquo;</blockquote>
      <div class="quote-attr"><span class="bar"></span><div><b>{{ t.name }}</b><span>{{ t.designation }}</span></div></div>
    </div>
    {% endif %}{% endfor %}
    <div class="quote-dots"></div>
  </div>
</section>

<!-- ============ SECTORS ============ -->
<section class="section">
  <div class="container">
    <div class="sec-head reveal">
      <div>
        <p class="eyebrow">Who we advise</p>
        <h2>Sectors we work across</h2>
      </div>
    </div>
    <div class="sector-strip reveal">
      {% for s in sectors %}<a class="sector-chip" href="/practice-areas/#{{ s.id }}">{{ s.name }}</a>{% endfor %}
    </div>
  </div>
</section>

<!-- ============ INSIGHTS PREVIEW ============ -->
<section class="section bg-alt">
  <div class="container">
    <div class="sec-head reveal">
      <div>
        <p class="eyebrow">Legal Insights</p>
        <h2>Recent writing from the chambers</h2>
      </div>
      <a href="/legal-insights/" class="btn btn-outline sec-link">All Legal Insights</a>
    </div>
    <div class="insight-grid reveal">
      {% for article in collections.legalInsights %}{% if loop.index <= 3 %}
      <a class="insight-card" href="{{ article.url }}">
        <div class="insight-img"><img src="{{ article.data.image | imgSize(800, 65) }}" alt="{{ article.data.title }}" width="800" height="500" loading="lazy" decoding="async"><span class="insight-tag">{{ article.data.tag }}</span></div>
        <div class="insight-body">
          <h3>{{ article.data.title }}</h3>
          <div class="meta"><span>{{ article.data.readTime }}</span><span>Legal Insights</span></div>
        </div>
      </a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<!-- ============ CTA ============ -->
{% set newsletterVariant = "light" %}
{% include "newsletter.njk" %}

<section class="cta-band grain">
  <div class="container">
    <p class="eyebrow" style="justify-content:center">Start a conversation</p>
    <h2>Let's build with confidence. Talk to the chambers.</h2>
    <div class="btn-row">
      <a href="/contact/" class="btn btn-primary">Make an Enquiry</a>
      <a href="tel:{{ site.phones[0].href }}" class="btn btn-ghost">Call {{ site.phones[0].number }}</a>
    </div>
  </div>
</section>
