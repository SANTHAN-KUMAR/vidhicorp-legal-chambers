<script>
(function(){
  "use strict";
  var checklist = document.getElementById("posh-checklist");
  if(!checklist) return;
  var boxes = checklist.querySelectorAll('input[type=checkbox]');
  var scoreWrap = document.getElementById("posh-score");
  var scoreNum = document.getElementById("posh-score-num");
  var scoreText = document.getElementById("posh-score-text");

  function update(){
    var total = 0, earned = 0, checkedCount = 0;
    boxes.forEach(function(b){
      var w = parseFloat(b.getAttribute("data-weight")) || 1;
      total += w;
      if(b.checked){ earned += w; checkedCount++; }
    });
    var pct = total ? (earned/total)*100 : 0;
    scoreNum.textContent = checkedCount + "/" + boxes.length;
    scoreWrap.style.display = "flex";
    if(pct >= 95){
      scoreWrap.style.background = "rgba(47,107,79,.12)";
      scoreNum.style.color = "var(--success)";
      scoreText.textContent = "Your Internal Committee looks fully aligned with the Act's core requirements. Keep the annual report and training cadence current.";
    } else if(pct >= 60){
      scoreWrap.style.background = "var(--bg-alt)";
      scoreNum.style.color = "var(--accent-strong)";
      scoreText.textContent = "Broadly on track, with real gaps. Check the unticked items above — several (like the external member and reconstitution) go to whether the IC is validly constituted at all.";
    } else {
      scoreWrap.style.background = "rgba(163,42,34,.1)";
      scoreNum.style.color = "var(--error)";
      scoreText.textContent = "Significant gaps against the Act's requirements. Worth a formal review before this is tested by an actual complaint.";
    }
  }

  boxes.forEach(function(b){ b.addEventListener("change", update); });
})();
</script>
