<script>
(function(){
  "use strict";
  var btn = document.getElementById("esop-calc-btn");
  if(!btn) return;
  var fmtPct = function(n){ return n.toFixed(1) + "%"; };
  var fmtINR = function(n){
    if(n >= 10000000) return "₹" + (n/10000000).toFixed(2) + " Cr";
    if(n >= 100000) return "₹" + (n/100000).toFixed(2) + " L";
    return "₹" + n.toLocaleString("en-IN");
  };
  btn.addEventListener("click", function(){
    var invest = parseFloat(document.getElementById("esop-invest").value);
    var premoney = parseFloat(document.getElementById("esop-premoney").value);
    var existingPool = parseFloat(document.getElementById("esop-existing-pool").value);
    var targetPool = parseFloat(document.getElementById("esop-target-pool").value);

    var result = document.getElementById("esop-result");
    var explain = document.getElementById("esop-out-explain");

    if(!(invest > 0) || !(premoney > 0) || isNaN(existingPool) || isNaN(targetPool) || targetPool < 0 || targetPool > 99){
      result.classList.add("is-visible");
      document.getElementById("esop-out-investor").textContent = "—";
      document.getElementById("esop-out-pool").textContent = "—";
      document.getElementById("esop-out-founders").textContent = "—";
      document.getElementById("esop-out-postmoney").textContent = "—";
      explain.textContent = "Enter a positive investment amount, a positive pre-money valuation, and a target pool between 0% and 99% to see a result.";
      return;
    }

    var postMoney = premoney + invest;
    var investorPct = (invest / postMoney) * 100;
    var founderPct = 100 - targetPool - investorPct;
    var extraDilution = targetPool - existingPool;

    document.getElementById("esop-out-investor").textContent = fmtPct(investorPct);
    document.getElementById("esop-out-pool").textContent = fmtPct(targetPool);
    document.getElementById("esop-out-founders").textContent = fmtPct(Math.max(founderPct, 0));
    document.getElementById("esop-out-postmoney").textContent = fmtINR(postMoney);

    if(founderPct < 0){
      explain.textContent = "The target pool plus the investor's percentage exceed 100% — this combination isn't mathematically possible. Re-check your inputs.";
    } else {
      explain.textContent = "Founders and existing shareholders absorb the pool top-up on top of the investment dilution: the pool grew from " + fmtPct(existingPool) + " to " + fmtPct(targetPool) + " (" + (extraDilution >= 0 ? "+" : "") + fmtPct(extraDilution) + "), all of which comes out of the pre-money side of the table under a pre-money pool shuffle.";
    }

    result.classList.add("is-visible");
  });
})();
</script>
